# Copia este archivo como .env y completá los valores reales.

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
HOSPI_DB_PATH=./data/hospi.db
HOSPI_UPLOADS_DIR=./uploads
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# SMTP (opcional, para email real)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=tu-email@dominio.com
SMTP_PASS=tu-password
SMTP_FROM=tu-email@dominio.com

# Twilio (opcional, para WhatsApp real)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Turso (opcional, reemplaza SQLite local si lo configurás)
TURSO_DATABASE_URL=https://tu-db.turso.io
TURSO_AUTH_TOKEN=tu-token-turso

# Cloudinary (para adjuntos remotos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
